# Copiar a `.env` y completar. `config/env.js` valida al arrancar lo que es
# obligatorio, así que si falta algo crítico el server no levanta y lo dice.

# --- Base de datos (PostgreSQL) ---
# Si se omiten, config/db.js usa defaults de desarrollo local.
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=gimnasio
DB_PORT=5432

# --- Servidor ---
PORT=3001

# --- Autenticación ---
# OBLIGATORIA. Clave con la que se firman los JWT: sin ella no se puede
# iniciar sesión. Usar una cadena larga y aleatoria (32+ caracteres) y NO
# reutilizar la de otro ambiente. Al cambiarla, todos los tokens vigentes
# quedan inválidos y los usuarios tienen que volver a loguearse.
JWT_SECRET=

# Duración del token. Formatos de `jsonwebtoken`: "4h", "1d", "30m".
JWT_EXPIRES_IN=1d

# --- CORS ---
# Lista de orígenes permitidos separados por comas, ej:
#   ALLOWED_ORIGINS=http://192.168.0.17:3006,http://192.168.0.17:3008
# "*" abre a cualquier origen: sólo aceptable en una LAN cerrada.
ALLOWED_ORIGINS=*

# --- Límite de intentos de login (opcional) ---
# Ventana en minutos, máximo de intentos FALLIDOS por IP+usuario, y techo por
# IP sola (contra rociado de contraseñas sobre muchas cuentas).
# Defaults: 15 minutos / 10 por usuario / 100 por IP.
LOGIN_RATE_WINDOW_MIN=15
LOGIN_RATE_MAX=10
LOGIN_RATE_MAX_IP=100

# --- Reverse proxy (opcional) ---
# Definir SÓLO si la API queda detrás de nginx/Cloudflare/etc. Sin proxy real,
# activarlo permite falsear la IP del cliente con X-Forwarded-For y burlar los
# limitadores. Valores: cantidad de saltos ("1") o un preset de Express
# ("loopback"). Sin proxy: dejar vacío o borrar la línea.
# TRUST_PROXY=1
